PORT=4000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=rootpassword
DB_NAME=hrms_db

# Security & JWT
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_32char
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_64char
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# File Uploads
UPLOAD_DEST=./uploads

